{
  "name": "golden-hour",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shoot.mjs",
    "journey": "node scripts/journey.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "eval": "node scripts/eval.mjs",
    "docs:honesty": "vitest run -u lib/honesty.test.ts",
    "eval:images": "node scripts/make-eval-images.mjs",
    "eval:extract": "node scripts/eval-extract.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@upstash/redis": "^1.38.2",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
