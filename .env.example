# Copy to .env.local for development, and set the same keys in the Vercel
# project environment before deploying. Check /api/health on the deployed URL —
# it reports deploy_ready and names anything missing.

# --- Required for live extraction ---------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Required for a working deployment ----------------------------------
# Without these the store falls back to an in-memory Map. That is fine locally
# and broken on Vercel: every serverless invocation is a separate process, so
# the receipt request usually lands somewhere that has never seen the packet.
# Free tier at https://console.upstash.com — create a Redis database, copy the
# REST url and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional -----------------------------------------------------------
# Escalate to gemini-3.7-flash if OCR on cracked-screen photos underperforms.
GEMINI_MODEL_EXTRACT=gemini-3.5-flash-lite

# How long to wait for the model before handing the user a manual form. The
# clock does not stop for our infrastructure.
EXTRACT_TIMEOUT_MS=12000

# Thinking budget for the extraction call. LEAVE THIS BLANK unless you have
# checked the model accepts it: gemini-3.5-flash-lite rejects thinkingBudget=0
# outright, with a generic "Request contains an invalid argument." Blank means
# the key is not sent at all. Extraction retries without it if it is rejected.
GEMINI_THINKING_BUDGET=
